DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# AI (Anthropic API). Leave blank to run fully offline with the built-in bank.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
AI_QUESTION_RATE=0.35
# Database: sqlite (default) or postgres
DB_ENGINE=sqlite
POSTGRES_DB=logic_or_illogic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
